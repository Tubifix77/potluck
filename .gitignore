# Host test builds.
/build/

# ESP-IDF build output. Since the rename to an all-ASCII path the firmware builds
# in place (tools/build_firmware.ps1 only mirrors when the path forces it), so this
# directory exists routinely and is pure build product.
/firmware/build/
/firmware/sdkconfig
/firmware/sdkconfig.old
/firmware/managed_components/
/firmware/dependencies.lock

# Soak captures. These are measurement data, sometimes gigabytes of it. Keep the
# summary and the numbers in M0-LOG.md; keep the raw stream out of the history.
# Exception: the two small M2 acceptance captures are tracked -- M0-LOG.md Session 6
# cites them as the evidence behind the replay digests, and evidence you cannot
# open is a claim, not evidence.
/captures/*
!/captures/m2-acceptance.jsonl
!/captures/m2-ls.jsonl

# Local Claude Code session settings stay local; the zero-assumption ledger IS
# tracked, because CLAUDE.md rule 3 makes it part of the project's method rather
# than part of anyone's setup.
/.claude/*
!/.claude/zero-assumption/

# The differential fuzz corpus is ~4 MB and fully deterministic -- the C++ fuzzer
# uses fixed seeds, so regenerating it reproduces the same bytes. Generated by
# tools/run_all_tests.ps1, or by hand:
#   build/tests/pot_tests.exe --emit-fuzz-corpus host/potluck/tests/fixtures
# The much smaller stats_sample.jsonl in the same directory IS checked in: it is
# the serial-format contract and belongs in the history so a format change shows
# up as a diff.
/host/potluck/tests/fixtures/fuzz_corpus.jsonl
/host/potluck/tests/fixtures/serial_corpus.jsonl

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# Private keys. Never. The signing tool writes `<name>.key` next to `<name>.pub`, and a key that
# reaches a public repository is a key that has to be replaced along with everything it signed --
# so this is a pattern rather than a path, and it covers directories nobody has thought of yet.
*.key
keys/
!*.pub

# Signed packages are build output: they are reproducible from a manifest, a key and a counter.
*.potpkg.json
